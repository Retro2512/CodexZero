+#[test]
+fn preserves_non_styling_terminal_control_sequences() {
+    let raw = b"\x1b[2Jkept\x1b]0;title\x07\n";
+    let encoded = encode_terminal(raw);
+    assert_eq!(
+        decode_terminal(&encoded).unwrap(),
+        "\x1b[2Jkept\x1b]0;title\x07\n"
