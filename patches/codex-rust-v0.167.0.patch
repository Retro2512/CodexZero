+#[cfg(unix)]
+#[test]
+fn artifact_and_telemetry_permissions_are_private_and_repaired() {
+    use std::os::unix::fs::PermissionsExt;
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path().join("artifacts");
+    let artifact = store_raw(&root, b"private output").unwrap();
+    for directory in [&root, &root.join("sha256")] {
+        assert_eq!(
+            fs::metadata(directory).unwrap().permissions().mode() & 0o777,
+            0o700
+        );
+        fs::set_permissions(directory, fs::Permissions::from_mode(0o755)).unwrap();
+    }
+    assert_eq!(
+        fs::metadata(&artifact.path).unwrap().permissions().mode() & 0o777,
+        0o600
+    );
+    fs::set_permissions(&artifact.path, fs::Permissions::from_mode(0o644)).unwrap();
+    store_raw(&root, b"private output").unwrap();
+    assert_eq!(
+        fs::metadata(&artifact.path).unwrap().permissions().mode() & 0o777,
+        0o600
+    );
+    assert_eq!(
+        fs::metadata(&root).unwrap().permissions().mode() & 0o777,
+        0o700
+    );
+    assert_eq!(
+        fs::metadata(root.join("sha256"))
+            .unwrap()
+            .permissions()
+            .mode()
+            & 0o777,
+        0o700
+    );
+    let telemetry = temp.path().join("telemetry/record.jsonl");
+    append_telemetry_to(&telemetry, &serde_json::json!({"ok": true})).unwrap();
+    assert_eq!(
+        fs::metadata(&telemetry).unwrap().permissions().mode() & 0o777,
+        0o600
+    );
+    fs::set_permissions(&telemetry, fs::Permissions::from_mode(0o644)).unwrap();
+    append_telemetry_to(&telemetry, &serde_json::json!({"ok": true})).unwrap();
+    assert_eq!(
+        fs::metadata(&telemetry).unwrap().permissions().mode() & 0o777,
+        0o600
+    );
+}
+
+#[cfg(unix)]
+#[test]
+fn private_storage_rejects_symlinks() {
+    use std::os::unix::fs::symlink;
+    let temp = tempfile::tempdir().unwrap();
+    let outside = temp.path().join("outside");
+    fs::create_dir(&outside).unwrap();
+    let root = temp.path().join("artifacts");
+    symlink(&outside, &root).unwrap();
+    assert!(store_raw(&root, b"private").is_err());
+    assert!(!outside.join("sha256").exists());
+    let file = outside.join("file");
+    fs::write(&file, b"untouched").unwrap();
+    let telemetry = temp.path().join("telemetry.jsonl");
+    symlink(&file, &telemetry).unwrap();
+    assert!(append_telemetry_to(&telemetry, &serde_json::json!({})).is_err());
+    assert_eq!(fs::read(file).unwrap(), b"untouched");
+}
