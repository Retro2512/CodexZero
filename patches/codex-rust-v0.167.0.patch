+++ b/codex-rs/app-server/src/config_manager_provider_tests.rs
@@ -320,3 +320,37 @@ name = "Gateway"
     );
     Ok(())
 }
+
+/// CodexZero custom-model chats may continue while another provider is selected, and back.
+#[tokio::test]
+async fn codexzero_custom_provider_chats_are_admitted_beside_the_selection() -> Result<()> {
+    let home = tempdir()?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        r#"
+model_provider = "openai"
+[model_providers.codexzero_custom]
+name = "CodexZero"
+[model_providers.gateway]
+name = "Gateway"
+"#,
+    )?;
+    let manager = ConfigManager::without_managed_config_for_tests(home.path().to_path_buf());
+    let mut current = manager
+        .load_latest_config(Some(home.path().to_path_buf()))
+        .await?;
+    current.model_provider_id = "codexzero_custom".into();
+    manager
+        .check_thread_model_provider_for_input(&current)
+        .await?;
+    current.model_provider_id = "gateway".into();
+    assert!(
+        manager
+            .check_thread_model_provider_for_input(&current)
+            .await
+            .is_err()
+    );
+    assert!(codexzero_provider_switch("openai", "codexzero_custom"));
+    assert!(!codexzero_provider_switch("gateway", "openai"));
+    Ok(())
+}
