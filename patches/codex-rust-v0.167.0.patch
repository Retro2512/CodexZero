+#[tokio::test]
+async fn output_collection_can_return_on_first_output() {
+    let output_buffer = Arc::new(tokio::sync::Mutex::new(OutputBuffers::<1024>::default()));
+    let output_notify = Arc::new(Notify::new());
+    let output_closed = Arc::new(AtomicBool::new(false));
+    let output_closed_notify = Arc::new(Notify::new());
+    let cancellation_token = CancellationToken::new();
+    let output = OutputHandles {
+        output_buffer: Arc::clone(&output_buffer),
+        output_notify: Arc::clone(&output_notify),
+        output_closed: Arc::clone(&output_closed),
+        output_closed_notify: Arc::clone(&output_closed_notify),
+        cancellation_token: cancellation_token.clone(),
+        collection_finished: CancellationToken::new(),
+        drain_policy: OutputDrainPolicy::BoundedAfterExit,
+    };
+
+    let collect = UnifiedExecProcessManager::collect_output_until_deadline(
+        &output,
+        /*pause_state*/ None,
+        OutputCollectionMode::UntilOutput(Instant::now() + Duration::from_secs(1)),
+    );
+    let produce = async {
+        tokio::time::sleep(Duration::from_millis(25)).await;
+        output_buffer
+            .lock()
+            .await
+            .push_chunk(ExecOutputStream::Stdout, b"ready");
+        output_notify.notify_one();
+        tokio::time::sleep(Duration::from_millis(75)).await;
+        output_buffer
+            .lock()
+            .await
+            .push_chunk(ExecOutputStream::Stdout, b"later");
+        output_notify.notify_one();
+    };
+
+    let (collected, ()) = tokio::join!(collect, produce);
+    assert_eq!(collected.to_bytes(), b"ready");
+    assert_eq!(output_buffer.lock().await.pending.to_bytes(), b"later");
+    assert_eq!(
+        output_buffer.lock().await.transcript.to_bytes(),
+        b"readylater"
+    );
+}
