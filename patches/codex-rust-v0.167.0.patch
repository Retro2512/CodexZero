+
+/// CodexZero routes custom models through its own provider per chat, so a chat may
+/// move between that provider and the selected one between turns.
+fn codexzero_provider_switch(thread_provider: &str, current_provider: &str) -> bool {
+    const CODEXZERO_PROVIDER_ID: &str = "codexzero_custom";
+    thread_provider == CODEXZERO_PROVIDER_ID || current_provider == CODEXZERO_PROVIDER_ID
+}
