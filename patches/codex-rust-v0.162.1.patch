+fn codex_zero_runtime_overrides(
+    value: Option<&std::ffi::OsStr>,
+    instructions_file: Option<&std::ffi::OsStr>,
+    scoped_runtime: Option<&std::ffi::OsStr>,
+) -> Vec<String> {
+    if value != Some(std::ffi::OsStr::new("1")) {
+        return Vec::new();
+    }
+
+    // Defaults come from the selected profile, never command line overrides.
+    let mut overrides = Vec::new();
+    if scoped_runtime == Some(std::ffi::OsStr::new("1")) {
+        overrides.extend([
+            "features.code_mode=true".to_string(),
+            "features.code_mode_only=true".to_string(),
+            "features.codex_zero_scoped_runtime=true".to_string(),
+        ]);
+    }
+    if let Some(instructions_file) = instructions_file.filter(|value| !value.is_empty())
+        && let Ok(value) = serde_json::to_string(&instructions_file.to_string_lossy())
+    {
+        overrides.push(format!("model_instructions_file={value}"));
+    }
+    overrides
+}
+
+fn codex_zero_profile(
+    enabled: Option<&std::ffi::OsStr>,
+    profile: Option<&std::ffi::OsStr>,
+) -> anyhow::Result<Option<ProfileV2Name>> {
+    if enabled != Some(std::ffi::OsStr::new("1")) {
+        return Ok(None);
+    }
+    let name = profile.unwrap_or(std::ffi::OsStr::new("codexzero"));
+    let name = name
+        .to_str()
+        .ok_or_else(|| anyhow::anyhow!("Invalid CodexZero profile"))?;
+    Ok(Some(name.parse()?))
+}
