+    store_raw(&root, b"private output").unwrap();
+    assert_eq!(
+        fs::metadata(&artifact.path).unwrap().permissions().mode() & 0o777,
+        0o600
+    );
+    assert_eq!(
+        fs::metadata(&root).unwrap().permissions().mode() & 0o777,
+        0o700
