diff --git a/codex-rs/codex-zero-codec/src/lib.rs b/codex-rs/codex-zero-codec/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..94b8fe639c0c2de951203e4207ac07e434afe8ba
--- /dev/null
+++ b/codex-rs/codex-zero-codec/src/lib.rs
@@ -0,0 +1,336 @@
+use anyhow::Context;
+use anyhow::Result;
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+use std::fs;
+use std::fs::OpenOptions;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use tiktoken_rs::o200k_base_singleton;
+
+const RLE_CODEC: &str = "line-rle-v1";
+static NEXT_TEMP_ID: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Artifact {
+    pub sha256: String,
+    pub byte_count: usize,
+    pub path: PathBuf,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MonotonicSelection {
+    pub text: String,
+    pub original_tokens: usize,
+    pub selected_tokens: usize,
+    pub transformed: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TerminalEncoding {
+    pub text: String,
+    pub codec: Option<&'static str>,
+    pub presentation_changed: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+struct LineRle {
+    codec: String,
+    runs: Vec<LineRun>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+struct LineRun {
+    count: usize,
+    text: String,
+}
+
+pub fn token_count(text: &str) -> usize {
+    o200k_base_singleton()
+        .encode_with_special_tokens(text)
+        .len()
+}
+
+pub fn sha256(raw: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(raw))
+}
+
+pub fn select_strictly_smaller(original: &str, candidate: String) -> MonotonicSelection {
+    let original_tokens = token_count(original);
+    let candidate_tokens = token_count(&candidate);
+    if candidate_tokens < original_tokens {
+        MonotonicSelection {
+            text: candidate,
+            original_tokens,
+            selected_tokens: candidate_tokens,
+            transformed: true,
+        }
+    } else {
+        MonotonicSelection {
+            text: original.to_string(),
+            original_tokens,
+            selected_tokens: original_tokens,
+            transformed: false,
+        }
+    }
+}
+
+pub fn store_raw(root: &Path, raw: &[u8]) -> Result<Artifact> {
+    let sha256 = sha256(raw);
+    let directory = root.join("sha256");
+    let path = directory.join(&sha256);
+    fs::create_dir_all(&directory).with_context(|| {
+        format!(
+            "failed to create artifact directory {}",
+            directory.display()
+        )
+    })?;
+    if path.exists() {
+        let existing = fs::read(&path)
+            .with_context(|| format!("failed to verify raw artifact {}", path.display()))?;
+        anyhow::ensure!(
+            existing == raw,
+            "artifact hash collision or corruption at {}",
+            path.display()
+        );
+    } else {
+        let temporary = directory.join(format!(
+            ".{sha256}.{}.{}.tmp",
+            std::process::id(),
+            NEXT_TEMP_ID.fetch_add(1, Ordering::Relaxed)
+        ));
+        let mut file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&temporary)
+            .with_context(|| format!("failed to create raw artifact {}", temporary.display()))?;
+        file.write_all(raw)
+            .with_context(|| format!("failed to write raw artifact {}", temporary.display()))?;
+        file.sync_all()
+            .with_context(|| format!("failed to flush raw artifact {}", temporary.display()))?;
+        drop(file);
+        if let Err(error) = fs::rename(&temporary, &path) {
+            if path.exists() {
+                let _ = fs::remove_file(&temporary);
+                let existing = fs::read(&path).with_context(|| {
+                    format!("failed to verify raced raw artifact {}", path.display())
+                })?;
+                anyhow::ensure!(
+                    existing == raw,
+                    "artifact hash collision or corruption at {}",
+                    path.display()
+                );
+            } else {
+                return Err(error).with_context(|| {
+                    format!(
+                        "failed to move raw artifact {} to {}",
+                        temporary.display(),
+                        path.display()
+                    )
+                });
+            }
+        }
+    }
+
+    Ok(Artifact {
+        sha256,
+        byte_count: raw.len(),
+        path,
+    })
+}
+
+pub fn append_telemetry(record: &serde_json::Value) -> Result<bool> {
+    let Ok(path) = std::env::var("CODEX_ZERO_TELEMETRY_FILE") else {
+        return Ok(false);
+    };
+    let path = PathBuf::from(path);
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent).with_context(|| {
+            format!("failed to create telemetry directory {}", parent.display())
+        })?;
+    }
+    let mut file = OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(&path)
+        .with_context(|| format!("failed to open telemetry file {}", path.display()))?;
+    serde_json::to_writer(&mut file, record).context("failed to serialize telemetry record")?;
+    file.write_all(b"\n")
+        .context("failed to terminate telemetry record")?;
+    Ok(true)
+}
+
+pub fn encode_terminal(raw: &[u8]) -> TerminalEncoding {
+    let source = String::from_utf8_lossy(raw);
+    let without_presentation = strip_presentation_ansi(&source);
+    let presentation_changed = without_presentation != source;
+    let normalized = normalize_line_endings_if_smaller(&without_presentation);
+    let plain_tokens = token_count(&normalized);
+    let rle = encode_line_runs(&normalized);
+
+    if let Ok(rle_text) = serde_json::to_string(&rle)
+        && token_count(&rle_text) < plain_tokens
+    {
+        return TerminalEncoding {
+            text: rle_text,
+            codec: Some(RLE_CODEC),
+            presentation_changed,
+        };
+    }
+
+    TerminalEncoding {
+        text: normalized,
+        codec: None,
+        presentation_changed,
+    }
+}
+
+pub fn decode_terminal(encoded: &TerminalEncoding) -> Result<String> {
+    match encoded.codec {
+        Some(RLE_CODEC) => {
+            let rle: LineRle =
+                serde_json::from_str(&encoded.text).context("invalid line-rle payload")?;
+            let mut decoded = String::new();
+            for run in rle.runs {
+                for _ in 0..run.count {
+                    decoded.push_str(&run.text);
+                }
+            }
+            Ok(decoded)
+        }
+        Some(codec) => anyhow::bail!("unsupported terminal codec {codec}"),
+        None => Ok(encoded.text.clone()),
+    }
+}
+
+fn normalize_line_endings_if_smaller(text: &str) -> String {
+    if !text.contains('\r') {
+        return text.to_string();
+    }
+
+    let normalized = text.replace("\r\n", "\n").replace('\r', "\n");
+    if token_count(&normalized) < token_count(text) {
+        normalized
+    } else {
+        text.to_string()
+    }
+}
+
+fn encode_line_runs(text: &str) -> LineRle {
+    let mut runs: Vec<LineRun> = Vec::new();
+    for line in text.split_inclusive('\n') {
+        if let Some(previous) = runs.last_mut()
+            && previous.text == line
+        {
+            previous.count += 1;
+        } else {
+            runs.push(LineRun {
+                count: 1,
+                text: line.to_string(),
+            });
+        }
+    }
+
+    if text.is_empty() {
+        runs.clear();
+    }
+
+    LineRle {
+        codec: RLE_CODEC.to_string(),
+        runs,
+    }
+}
+
+fn strip_presentation_ansi(text: &str) -> String {
+    let bytes = text.as_bytes();
+    let mut output = Vec::with_capacity(bytes.len());
+    let mut index = 0;
+    let mut active_hyperlink: Option<String> = None;
+
+    while index < bytes.len() {
+        if bytes[index] != 0x1b {
+            output.push(bytes[index]);
+            index += 1;
+            continue;
+        }
+
+        if index + 1 >= bytes.len() {
+            output.push(bytes[index]);
+            break;
+        }
+
+        match bytes[index + 1] {
+            b'[' => {
+                let sequence_start = index;
+                index += 2;
+                let mut final_byte = None;
+                while index < bytes.len() {
+                    let byte = bytes[index];
+                    index += 1;
+                    if (0x40..=0x7e).contains(&byte) {
+                        final_byte = Some(byte);
+                        break;
+                    }
+                }
+                if final_byte != Some(b'm') {
+                    output.extend_from_slice(&bytes[sequence_start..index]);
+                }
+            }
+            b']' => {
+                let sequence_start = index;
+                let content_start = index + 2;
+                index = content_start;
+                while index < bytes.len()
+                    && bytes[index] != 0x07
+                    && !(bytes[index] == 0x1b
+                        && index + 1 < bytes.len()
+                        && bytes[index + 1] == b'\\')
+                {
+                    index += 1;
+                }
+                let content = String::from_utf8_lossy(&bytes[content_start..index]);
+                let is_hyperlink = content.starts_with("8;;");
+                if let Some(link) = content.strip_prefix("8;;") {
+                    if link.is_empty() {
+                        if let Some(url) = active_hyperlink.take() {
+                            output.extend_from_slice(b" (");
+                            output.extend_from_slice(url.as_bytes());
+                            output.push(b')');
+                        }
+                    } else {
+                        active_hyperlink = Some(link.to_string());
+                    }
+                }
+                if index < bytes.len() && bytes[index] == 0x07 {
+                    index += 1;
+                } else if index + 1 < bytes.len() {
+                    index += 2;
+                }
+                if !is_hyperlink {
+                    output.extend_from_slice(&bytes[sequence_start..index]);
+                }
+            }
+            _ => {
+                output.extend_from_slice(&bytes[index..index + 2]);
+                index += 2;
+            }
+        }
+    }
+
+    if let Some(url) = active_hyperlink {
+        output.extend_from_slice(b" (");
+        output.extend_from_slice(url.as_bytes());
+        output.push(b')');
+    }
+
+    String::from_utf8_lossy(&output).into_owned()
+}
